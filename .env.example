# Public web-app identifiers; never put service-account keys or debug tokens here.
# Missing config leaves the app in explicit mock mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# App Check attestation: enterprise (default) or v3.
VITE_APP_CHECK_PROVIDER=enterprise
# Public reCAPTCHA site key for the chosen provider. VITE_RECAPTCHA_SITE_KEY is preferred;
# VITE_RECAPTCHA_ENTERPRISE_SITE_KEY remains as a backward-compatible fallback.
VITE_RECAPTCHA_SITE_KEY=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local dev only: true generates or uses a per-browser debug token in the console.
# To reuse a registered token, put it in gitignored .appcheck-debug-token or point
# APP_CHECK_DEBUG_TOKEN_FILE at a mode-600 file, then run `npm run dev`.
# Never paste a debug token into a VITE_* variable, the repo, or a production build.
VITE_APP_CHECK_DEBUG=false
# Cloud model used with the Gemini Developer API via Firebase AI Logic hybrid inCloudParams.
# Default matches the official hybrid web docs as of 2026-11-10.
VITE_CLOUD_MODEL=gemini-3.5-flash-lite
# Optional verified USD / 1M text-token rates; blank means unknown, not zero.
VITE_INPUT_USD_PER_MILLION=
VITE_OUTPUT_USD_PER_MILLION=
